# ==============================================================================
# Slotly Server Environment Configuration Template
# All configuration is namespaced with strict validation.
# Never commit real credentials or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# App Configuration (server/src/config/app.config.ts)
# ------------------------------------------------------------------------------
# Port the HTTP and WebSocket server listens on (default: 4000)
PORT=4000

# Environment mode: development | production | test (default: development)
NODE_ENV=development

# Web client frontend URL for CORS, email links, and OAuth redirects
CLIENT_URL=http://localhost:3000

# Comma-separated list of allowed CORS origins (default: http://localhost:3000)
CORS_ORIGINS=http://localhost:3000

# Global API route prefix (default: empty for root routes)
API_PREFIX=

# Application log level: log | error | warn | debug | verbose (default: log)
LOG_LEVEL=log

# ------------------------------------------------------------------------------
# Database Configuration (server/src/config/database.config.ts)
# ------------------------------------------------------------------------------
# MongoDB connection URI (REQUIRED). Must start with mongodb:// or mongodb+srv://
# NOTE: MongoDB Replica Set (rs0) is required for transactions (use docker compose)
DATABASE_URL=mongodb://localhost:27017/slotly?replicaSet=rs0&directConnection=true

# Server selection timeout in milliseconds (default: 5000)
DATABASE_TIMEOUT_MS=5000

# Maximum connection pool size (default: 50)
DATABASE_MAX_POOL_SIZE=50

# ------------------------------------------------------------------------------
# Redis Configuration (server/src/config/redis.config.ts)
# ------------------------------------------------------------------------------
# Redis server host (default: localhost)
REDIS_HOST=localhost

# Redis server port (default: 6379)
REDIS_PORT=6379

# Redis password (optional, leave blank for no authentication)
REDIS_PASSWORD=

# Redis database index (default: 0)
REDIS_DB=0

# Use TLS for Redis connection (true | false, default: false)
REDIS_TLS=false

# ------------------------------------------------------------------------------
# JWT Configuration (server/src/config/jwt.config.ts)
# ------------------------------------------------------------------------------
# Secret key for signing short-lived access tokens (REQUIRED, min 16 characters)
JWT_ACCESS_SECRET=your-minimum-16-characters-access-token-secret-here

# Expiration duration for access tokens (e.g. 15m, 1h, default: 15m)
JWT_ACCESS_EXPIRES_IN=15m

# Secret key for signing refresh tokens (REQUIRED, min 16 characters)
JWT_REFRESH_SECRET=your-minimum-16-characters-refresh-token-secret-here

# Expiration duration for refresh tokens (e.g. 7d, 30d, default: 7d)
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# Session Configuration (server/src/config/session.config.ts)
# ------------------------------------------------------------------------------
# Redis session idle TTL in seconds (default: 604800 = 7 days)
SESSION_TTL=604800

# Hard session maximum lifetime in seconds (default: 2592000 = 30 days)
SESSION_MAX_LIFETIME=2592000

# Name of the httpOnly cookie carrying the refresh token (default: slotly_rt)
SESSION_COOKIE_NAME=slotly_rt

# Cookie sameSite policy: lax | strict | none (default: lax)
SESSION_COOKIE_SAME_SITE=lax

# Cookie secure flag: true | false (default: false in dev, true in production)
SESSION_COOKIE_SECURE=false

# Cookie domain (optional, e.g. .example.com)
SESSION_COOKIE_DOMAIN=

# ------------------------------------------------------------------------------
# Auth Configuration (server/src/config/auth.config.ts)
# ------------------------------------------------------------------------------
# Argon2 password hashing cost parameters
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Email OTP settings
OTP_LENGTH=6
OTP_TTL=600
OTP_COOLDOWN=60
OTP_MAX_ATTEMPTS=5

# Allow fixed master OTP '000000' in development only (default: false)
ENABLE_DEV_MASTER_OTP=false

# Step-up elevation window in seconds for sensitive operations (default: 300)
STEP_UP_WINDOW=300

# Rate limiting / throttling
THROTTLE_LOGIN_LIMIT=5
THROTTLE_LOGIN_TTL=60
THROTTLE_OTP_LIMIT=3
THROTTLE_OTP_TTL=60
THROTTLE_REFRESH_LIMIT=10
THROTTLE_REFRESH_TTL=60
THROTTLE_PASSWORD_RESET_LIMIT=3
THROTTLE_PASSWORD_RESET_TTL=60

# Password policy
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128

# ------------------------------------------------------------------------------
# OAuth Configuration (server/src/config/oauth.config.ts)
# ------------------------------------------------------------------------------
# Base URL for OAuth callback redirects (default: http://localhost:4000)
OAUTH_CALLBACK_BASE_URL=http://localhost:4000

# Google OAuth (leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (leave empty to disable)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# Email Configuration (server/src/config/email.config.ts)
# ------------------------------------------------------------------------------
# Email delivery driver: brevo | log (default: log in dev, brevo in prod)
EMAIL_DRIVER=log

# Brevo transactional API key (REQUIRED when EMAIL_DRIVER=brevo in production)
BREVO_API_KEY=

# Default sender email and name
BREVO_SENDER_EMAIL=noreply@slotly.local
BREVO_SENDER_NAME=Slotly

# HTTP timeout in milliseconds for email sending API requests (default: 10000)
EMAIL_TIMEOUT=10000

# Maximum retry attempts for failed email transmissions (default: 3)
EMAIL_MAX_RETRIES=3

# ------------------------------------------------------------------------------
# Cache Configuration (server/src/config/cache.config.ts)
# ------------------------------------------------------------------------------
# Default cache TTL in seconds (default: 3600)
CACHE_DEFAULT_TTL=3600
CACHE_BLUEPRINT_TTL=3600
CACHE_READINESS_TTL=1800
CACHE_TREE_TTL=7200
CACHE_SLOTS_TTL=1800
CACHE_USER_PROFILE_TTL=3600

# ------------------------------------------------------------------------------
# Queue Configuration (server/src/config/queue.config.ts)
# ------------------------------------------------------------------------------
# BullMQ queue key prefix (default: slotly)
QUEUE_PREFIX=slotly
QUEUE_ATTEMPTS=3
QUEUE_BACKOFF_DELAY=1000
QUEUE_REMOVE_ON_COMPLETE=100
QUEUE_REMOVE_ON_FAIL=500

# Worker concurrency per queue type
QUEUE_CONCURRENCY_WRITE_BEHIND=5
QUEUE_CONCURRENCY_SOLVER=2
QUEUE_CONCURRENCY_AUDIT=5
QUEUE_CONCURRENCY_NOTIFICATIONS=5
QUEUE_CONCURRENCY_EXPORT=2

# ------------------------------------------------------------------------------
# Groq LLM Configuration (server/src/config/groq.config.ts)
# ------------------------------------------------------------------------------
# Groq API key for AI assistant features (optional)
GROQ_API_KEY=

# Groq model identifier (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=4096
GROQ_TEMPERATURE=0.2
