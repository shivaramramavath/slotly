PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB (with replica set for transaction support)
MONGODB_URI=mongodb://localhost:27017/slotly?replicaSet=rs0&directConnection=true

# Redis (AOF persistence)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT & Authentication
JWT_ACCESS_SECRET=slotly-dev-super-secure-access-token-secret-32-chars
JWT_REFRESH_SECRET=slotly-dev-super-secure-refresh-token-secret-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# OAuth Social Login (Google & GitHub)
OAUTH_CALLBACK_BASE_URL=http://localhost:4000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Groq LLM API
GROQ_API_KEY=

# Mail / Notifications (Brevo API or SMTP)
BREVO_API_KEY=
EMAIL_FROM=noreply@slotly.local
EMAIL_FROM_NAME=Slotly
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
